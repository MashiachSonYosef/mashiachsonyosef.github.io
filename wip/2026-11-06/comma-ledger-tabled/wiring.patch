index 00000000..b65dc185
--- /dev/null
+++ b/reader/tools/bake-declared-cuts-v1.mjs
@@ -0,0 +1,153 @@
+// GUARDS: provider-declaration-rule-v2-a-declared-dictionary-is-cut-by-its-own-ledger
+//
+// A dictionary whose punctuation the corpus lane has ledgered (ask v1.1,
+// wip/2026-10-31/provider-declarations) is cut into readings by its own
+// declaration, not by the global comma rule (sense-split-rule-v3): a route
+// divides at the occurrences of its declaration's dividing shapes, at the
+// mark itself, and nowhere else. A branch the owner has ruled to the option
+// that divides adds its shapes; a branch resting, or ruled to the option
+// that does not divide, adds none. Every piece is a run of the dictionary's
+// own characters; the pieces and the marks between them rejoin to the route.
+//
+// The declaration's classifier is run here, over every route of the source
+// in the served route store, and only the routes it divides are written out,
+// each with the offsets (UTF-16) of the marks it divides at: a route of a
+// declared source that is not in the file is one reading, whole. A reader
+// of the file cuts the route at each offset, drops the mark and trims each
+// piece (tools/declared-cut-v1.mjs; zone.html carries the same lines).
+// The page and the bakes read the file; nobody runs the classifier at view.
+//
+// Usage:
+//   node tools/bake-declared-cuts-v1.mjs --m M9 \
+//     --dir data/provider-declarations/openscriptures_strongs \
+//     --relay <FOR-ELIJAH-v102.md> \
+//     --ruling B01=whole --ruling B02=whole --ruled "the owner, 2026-11-06" \
+//     [--store data/route-store] [--out data/declared-cuts-v1.json]
+//
+// Refuses when a file's sha256 is not the relay's, when a branch has no
+// ruling or an option the branch does not offer, when a cut falls in a text
+// whose brackets do not balance (rule 3), when a piece is empty or the pieces
+// do not rejoin, or when the dividing occurrences do not sum to the dividing
+// shapes' declared counts.
+import { readFileSync, readdirSync, writeFileSync, existsSync } from "node:fs";
+import { join, resolve, basename } from "node:path";
+import { createHash } from "node:crypto";
+import { gunzipSync } from "node:zlib";
+import { pathToFileURL } from "node:url";
+
+const RULE_ID = "provider-declaration-rule-v2-a-declared-dictionary-is-cut-by-its-own-ledger";
+const argv = process.argv.slice(2);
+const arg = (name, dflt = null) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : dflt; };
+const args = (name) => argv.flatMap((a, i) => (a === name ? [argv[i + 1]] : []));
+const fail = (msg) => { console.error(`refused: ${msg}`); process.exit(1); };
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+
+const M = arg("--m");
+const DIR = arg("--dir");
+const RELAY = arg("--relay");
+const STORE = arg("--store", "data/route-store");
+const OUT = arg("--out", "data/declared-cuts-v1.json");
+const RULED = arg("--ruled");
+if (!M || !DIR || !RELAY || !RULED) fail("usage: --m <M id> --dir <declaration folder> --relay <relay.md> --ruling Bnn=<option> ... --ruled <who, when>");
+
+// the relay's own table of files: every file read here must carry the sha256 the relay gives it
+const relay = readFileSync(RELAY, "utf8");
+const relayShaOf = (file) => {
+  const row = relay.split("\n").find((l) => l.startsWith("|") && l.includes(`(${file})`));
+  const m = row && row.match(/\|\s*([0-9a-f]{64})\s*\|/);
+  return m ? m[1] : null;
+};
+const files = readdirSync(DIR);
+const declFile = files.find((f) => f.endsWith(".declaration.json"));
+const classFile = files.find((f) => f.endsWith(".classifier.mjs"));
+if (!declFile || !classFile) fail(`${DIR} holds no declaration and classifier`);
+const declBytes = readFileSync(join(DIR, declFile));
+const classBytes = readFileSync(join(DIR, classFile));
+for (const [f, b] of [[declFile, declBytes], [classFile, classBytes]]) {
+  const want = relayShaOf(f);
+  if (!want) fail(`the relay names no sha256 for ${f}`);
+  if (sha(b) !== want) fail(`${f} is ${sha(b).slice(0, 12)}, the relay says ${want.slice(0, 12)}`);
+}
+const decl = JSON.parse(declBytes);
+if (!decl.m_ids || !decl.m_ids.includes(M)) fail(`the declaration is for ${JSON.stringify(decl.m_ids)}, not ${M}`);
+
+// the rulings: one per branch, an option the branch offers
+const rulings = Object.fromEntries(args("--ruling").map((r) => r.split("=")));
+const branches = decl.branches || [];
+for (const b of branches) {
+  const opt = rulings[b.id];
+  if (!opt) fail(`branch ${b.id} has no ruling ("${b.question}")`);
+  if (!(b.options || []).some((o) => o.id === opt)) fail(`branch ${b.id} offers ${(b.options || []).map((o) => o.id).join(", ")}, not ${opt}`);
+}
+for (const id of Object.keys(rulings)) if (!branches.some((b) => b.id === id)) fail(`the declaration has no branch ${id}`);
+const dividing = new Set(decl.shapes.filter((s) => s.divides).map((s) => s.id));
+const ruledToDivide = branches.filter((b) => rulings[b.id] !== b.resting);
+for (const b of ruledToDivide) for (const id of b.shapes) dividing.add(id);
+const declaredCuts = decl.shapes.filter((s) => dividing.has(s.id)).reduce((n, s) => n + s.count, 0);
+
+const { classify } = await import(pathToFileURL(resolve(DIR, classFile)).href);
+const OPEN = { "(": ")", "[": "]", "<": ">", "{": "}" };
+const CLOSE = { ")": "(", "]": "[", ">": "<", "}": "{" };
+const unbalanced = (text) => {
+  const st = [];
+  for (const ch of text) {
+    if (OPEN[ch]) st.push(ch);
+    else if (CLOSE[ch]) { if (st.length && OPEN[st[st.length - 1]] === ch) st.pop(); else return true; }
+  }
+  return st.length > 0;
+};
+
+const index = JSON.parse(readFileSync(join(STORE, "index.json"), "utf8"));
+const src = index.m_sources[M];
+if (!src) fail(`the store has no source ${M}`);
+if (src.key !== decl.source_key) fail(`${M} is ${src.key} in the store, the declaration is for ${decl.source_key}`);
+
+const cutsOf = {};
+let routes = 0, dividedRoutes = 0, cuts = 0;
+const texts = new Set();
+for (const f of readdirSync(join(STORE, "shards")).filter((x) => x.endsWith(".bin")).sort()) {
+  const shard = JSON.parse(gunzipSync(readFileSync(join(STORE, "shards", f))));
+  for (const rows of Object.values(shard)) for (const row of rows) {
+    if (row[3] !== M) continue;
+    routes += 1;
+    const text = String(row[1]);
+    texts.add(text);
+    const at = classify(text).filter((o) => dividing.has(o.shape)).map((o) => o.i).sort((a, b) => a - b);
+    if (!at.length) continue;
+    if (unbalanced(text)) fail(`a cut in a text whose brackets do not balance: ${text.slice(0, 60)}`);
+    const parts = []; let from = 0;
+    for (const c of at) { parts.push(text.slice(from, c)); from = c + 1; }
+    parts.push(text.slice(from));
+    let rejoined = parts[0]; at.forEach((c, n) => { rejoined += text[c] + parts[n + 1]; });
+    if (rejoined !== text) fail(`the pieces do not rejoin: ${text.slice(0, 60)}`);
+    if (parts.some((p) => !p.trim())) fail(`an empty piece: ${text.slice(0, 60)}`);
+    dividedRoutes += 1; cuts += at.length;
+    cutsOf[text] = at;
+  }
+}
+if (routes !== decl.routes) fail(`${routes} routes of ${M} in the store, the declaration read ${decl.routes}`);
+if (cuts !== declaredCuts) fail(`${cuts} dividing occurrences, the dividing shapes declare ${declaredCuts}`);
+
+const sortedCuts = Object.fromEntries(Object.keys(cutsOf).sort().map((t) => [t, cutsOf[t]]));
+const prior = existsSync(OUT) ? JSON.parse(readFileSync(OUT, "utf8")) : { sources: {} };
+const out = {
+  schema: "mishkan.declared_cuts.v1",
+  rule: RULE_ID,
+  note: "A route of a source named here is divided only where its declaration's dividing shapes stand (and the shapes of a branch ruled to divide), at the mark itself: cuts gives, for each route text it divides, the UTF-16 offsets of those marks; each piece is the text between two cuts, trimmed. A route of such a source that is not listed under cuts is one reading, whole; one whose brackets do not balance is held back whole, as sense-split-rule-v3 rule 4 holds a damaged field. Any other source keeps sense-split-rule-v3.",
+  sources: { ...prior.sources },
+};
+out.sources[M] = {
+  source_key: decl.source_key,
+  label: src.label,
+  relay: basename(RELAY),
+  declaration: { file: declFile, sha256: sha(declBytes) },
+  classifier: { file: classFile, sha256: sha(classBytes) },
+  store_version: index.store_version,
+  dividing_shapes: [...dividing].sort(),
+  rulings: Object.fromEntries(branches.map((b) => [b.id, { question: b.question, option: rulings[b.id], resting: b.resting, ruled: RULED, shapes: b.shapes, occurrences: b.occurrences }])),
+  counts: { routes, distinct_texts: texts.size, divided_routes: dividedRoutes, divided_texts: Object.keys(cutsOf).length, cuts },
+  cuts: sortedCuts,
+};
+const body = JSON.stringify(out);
+writeFileSync(OUT, body + "\n");
+console.log(`${M} ${decl.source_key}: ${routes} routes (${texts.size} texts); ${dividedRoutes} routes divided at ${cuts} cuts (${Object.keys(cutsOf).length} texts); dividing shapes ${dividing.size}; ${OUT} ${body.length + 1} bytes`);
diff --git a/reader/tools/declared-cut-v1.mjs b/reader/tools/declared-cut-v1.mjs
