+++ b/reader/tools/declared-cut-v1.mjs
@@ -0,0 +1,76 @@
+// GUARDS: provider-declaration-rule-v2-a-declared-dictionary-is-cut-by-its-own-ledger
+//
+// How a route's English becomes readings, for every consumer that asks:
+// a source the corpus lane has declared (data/declared-cuts-v1.json, baked by
+// tools/bake-declared-cuts-v1.mjs from the source's own declaration and the
+// owner's rulings of its branches) is cut by its declaration and nowhere
+// else; every other source keeps sense-split-rule-v3 (the pack mark ";" at
+// parenthesis depth zero, then the comma rule, tools/sense-split-v1.mjs).
+//
+// The rule, stated before any output:
+//
+//   1. A declared route divides only at the offsets the file gives for its
+//      exact text; the mark at each offset is dropped, and each piece is the
+//      text between two cuts, trimmed. Each piece is one reading.
+//   2. A declared route the file does not list is one reading, whole: its
+//      commas, semicolons and brackets are the dictionary's own notation
+//      (a King James list, a label before its gloss, a name and its
+//      description), and the page keeps them together.
+//   3. A declared route whose parentheses do not balance is held back whole,
+//      as sense-split-rule-v3 rule 4 holds a damaged field: neither printed
+//      nor pooled. Nothing is ever cut in such a text (the bake refuses it).
+//   4. The same answer on every surface: the card's pills, the line under the
+//      word, the record panel, the search index and the lattice sidecars ask
+//      this module (zone.html carries the same lines, and
+//      check-declared-cuts-v1 holds the two equal).
+//
+// Returns, for one route, the list of its senses as sense-split-rule-v3 gives
+// them: [{ readings: [...], damaged }]. For a declared source each piece is
+// its own sense of one reading.
+import { existsSync, readFileSync } from "node:fs";
+import { senseSplit as readingSplit, unbalancedAt } from "./sense-split-v1.mjs";
+
+export const DECLARED_CUT_RULE_ID = "provider-declaration-rule-v2-a-declared-dictionary-is-cut-by-its-own-ledger";
+
+/** The cut file, or null when this checkout carries none (every source then keeps the global rule). */
+export const openDeclaredCuts = (path) => (path && existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : null);
+
+/** The pack mark: ";" at parenthesis depth zero (sense-split-rule-v3's first layer). */
+export const packSplit = (text) => {
+  const t = String(text || "");
+  const out = []; let start = 0, d = 0;
+  for (let i = 0; i < t.length; i += 1) {
+    const c = t[i];
+    if (c === "(") d += 1;
+    else if (c === ")") { if (d > 0) d -= 1; }
+    else if (c === ";" && d === 0) { out.push(t.slice(start, i)); start = i + 1; }
+  }
+  out.push(t.slice(start));
+  if (out.join(";") !== t) return [t.trim()].filter(Boolean);
+  return out.map((x) => x.trim()).filter(Boolean);
+};
+
+/** The pieces of one declared route (rule 1, 2), or null when the source is not declared. */
+export const declaredPieces = (cutFile, text, mId) => {
+  const src = cutFile && cutFile.sources && cutFile.sources[mId];
+  if (!src) return null;
+  const t = String(text || "");
+  const at = src.cuts[t] || [];
+  const out = []; let from = 0;
+  for (const c of at) { out.push(t.slice(from, c)); from = c + 1; }
+  out.push(t.slice(from));
+  return out.map((p) => p.trim()).filter(Boolean);
+};
+
+/** Every sense of one route, as the card, the line and the index read it. */
+export const routeSenses = (cutFile, text, mId) => {
+  const pieces = declaredPieces(cutFile, text, mId);
+  if (!pieces) return packSplit(text).map((sense) => readingSplit(sense));
+  const t = String(text || "");
+  if (unbalancedAt(t) !== -1) return [{ readings: [t.trim()], whole: true, damaged: true, at: unbalancedAt(t) }];
+  return pieces.map((p) => ({ readings: [p], whole: true, damaged: false, at: -1 }));
+};
+
+/** The readings of one route, damaged senses held back. */
+export const routeReadings = (cutFile, text, mId) =>
+  routeSenses(cutFile, text, mId).flatMap((r) => (r.damaged ? [] : r.readings));
