{
  "schema_version": "1.0",
  "artifact_type": "agent2_source_lane_assignment_preflight_contract",
  "date": "2026-06-04",
  "mode": "WEEKLY_LEXICON_EXPANSION_GOAL_MODE",
  "workset": "old-dictionary-excluded-row-license-lane-reaudit",
  "target": "executable Agent 2 preflight validator for Agent 1 source-family / license-lane assignment packets before candidate generation",
  "script": "scripts/validate_agent2_source_lane_assignment_packet.mjs",
