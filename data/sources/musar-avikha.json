                      "sefaria_ref":  "Musar Avikha 1:1:5",
                      "hebrew":  [
                                     "על כן, החובה היא לעיין, שיהיה מכיר הדברים בהכרה פנימית, וממילא יתרחבו אצלו הדברים שמביאים לאותה ההכרה, עד שיעלה בידו להעניק מטוב ידיעתו גם לזולתו."
                                 ],
                      "license":  "Public Domain",
                      "version_title":  "Jerusalem, 1946",
                      "version_source":  "https://he.wikisource.org/wiki/%D7%9E%D7%95%D7%A1%D7%A8_%D7%90%D7%91%D7%99%D7%9A",
