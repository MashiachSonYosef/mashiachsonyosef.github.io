                      "source_ref":  "Words of Peace and Truth 1:1:8",
                      "sefaria_ref":  "Words of Peace and Truth 1:1:8",
                      "hebrew":  [
                                     "והנה לחנך נערי בני ישראל על הסדר הנכון, יחלק לשתי מחלקות, המחלקה האחת היא ללמדן תורת האדם, והן הדברים שבעבורן בעליהן ראויין להקרא בשם אדם, כי הנעדר מהן כמעט שלא יאות לו התאר הזה, וכמו שיתבאר. והמחלקה השניה היא ללמדו תורת ה׳, שהן חקי האלהים ותורותיו, דברים הנעלים משקול דעת כל אדם, ונודעו למשה רבינו ע״ה בנבואה ולולי שבאו אלינו על הדרך האלהי הזה, יהיו תעלומות גם מחכמי לב היותר גדולים, לפי שאין ענינם מסובב מן החקים הקבועים תחת השמש, גם לא נתחייבו בהן רק זרע ישראל לבד:"
                                 ],
                      "license":  "Public Domain",
                      "version_title":  "Warsaw, 1886",
                      "version_source":  "https://www.nli.org.il/he/books/NNL_ALEPH001809502/NLI",
                      "digitization":  "Sefaria API",
                      "source_url":  "https://www.sefaria.org/Words_of_Peace_and_Truth_1:1:8",
                      "import_date":  "2026-05-31"
                  },
                  {
                      "work_id":  "words-of-peace-and-truth",
                      "work_title":  "Words of Peace and Truth",
                      "group_title":  "Words of Peace and Truth",
                      "group_he_title":  "דברי שלום ואמת",
                      "group_slug":  "words-of-peace-and-truth",
                      "section_title":  "Words of Peace and Truth",
